{
  "manifest_version": 3,
  "name": "NHKラジオプレイヤー",
  "description": "NHKラジオとニュースをEdgeサイドバーで再生",
  "version": "1.0",
  "action": {
    "default_icon": "podcast.png",
    "default_title": "NHKラジオ"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.nhk.or.jp/s-media/news/podcast/list/v1/all.xml"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
