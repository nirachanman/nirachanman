{
  "manifest_version": 3,
  "name": "NHK Radio Sidebar",
  "version": "1.0",
  "description": "NHKラジオをサイドバーで再生するEdge拡張",
  "action": {
    "default_title": "NHKラジオ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
    // ✅ default_popup は削除（サイドバーを使うため）
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["<all_urls>"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
